{
  // MVP2 的第一个实战关卡，内容还在设计。步骤先照 MVP2 文档第二节列出，检测条件待补。
  // 网络：ws 只在外网，files01 只在内网，jump01 两边各一块网卡 —— 交换机按 VLAN 隔开，
  // 玩家的机器物理上够不着内网，只能经跳板机过去。
  "id": "jump-scan",
  "title": "跳板扫描",
  "track": "mission",
  "order": 0,
  "status": "draft",
  "requires": ["lab-ping"],
  "summary": "借一台跳板机穿进内网，拿到文件，全身而退。",
  "briefing": "你拿到了一台跳板机的登录方式。它背后是一段你直接够不着的内网，目标文件就在里面某台机器上。\n\n管理员会不定期登录跳板机查岗。别让他发现你来过。",
  "networks": [
    { "name": "outside", "vlan": 10, "subnet": "10.0.0.0/24" },
    { "name": "inside",  "vlan": 20, "subnet": "172.16.5.0/24" }
  ],
  "machines": [
    { "name": "ws",      "nics": [ { "network": "outside", "ip": "10.0.0.1" } ], "persona": "workstation", "disk": "alpine-main", "memory": 512 },
    { "name": "jump01",  "nics": [ { "network": "outside", "ip": "10.0.0.2" },
                                   { "network": "inside",  "ip": "172.16.5.1" } ], "persona": "legacy-server" },
    { "name": "files01", "nics": [ { "network": "inside",  "ip": "172.16.5.20" } ], "persona": "legacy-server" }
  ],
  // 管理员：一个会查岗的人，不是巡检脚本。
  // 每次登录只随手看几样（按各自的概率抽），看到小事只是起疑；
  // 疑心攒到 sweepAt 就把机器从头翻一遍，那一遍基本什么都藏不住。
  // 所以玩家要管理的不是「这次别被看到」，而是「别让他起疑心」。
  "admin": {
    "machine": "jump01",
    "user": "opsadm",
    "visibility": "shown",          // 高手模式改成 hidden：界面上不再显示他的动向
    "schedule": {
      "firstPatrolSeconds": 90,
      "intervalSeconds": 120,
      "jitterSeconds": 25,
      "minActions": 1,
      "maxActions": 3,
      "pauseMin": 1.5,
      "pauseMax": 5
    },
    "suspicion": {
      "sweepAt": 40,
      "exposedAt": 100,
      "calmPerPatrol": 5,           // 一次什么都没查出来，疑心退一点：人会放松
      "sweepMultiplier": 2
    },
    "allow": {
      "processes": ["syslogd*"],
      // ttyS2 是他自己的终端；ttyS0 是这台机器的物理控制台，上面一直有个 shell，
      // 属于常态。真正该让他起疑的是「除此之外还有人在」
      "sessions": ["ttyS2", "ttyS0"],
      "services": ["syslogd"],      // 玩家嫌它碍事把它杀了，同样可疑
      "logRedFlags": ["nc ", "tcpdump", "scp ", "/tmp/"]
    },
    "routine": [
      { "id": "sessions", "check": "sessions", "chance": 0.6, "weight": 20 },
      { "id": "processes", "check": "processes", "chance": 0.5, "weight": 20 },
      { "id": "log", "check": "log", "chance": 0.5, "weight": 25 },
      { "id": "services", "check": "services", "chance": 0.3, "weight": 30 }
    ],
    "sweep": ["sessions", "processes", "log", "services"],
    "stages": {
      // 玩家一开始扫内网，机房那边就会有动静，他来得更勤、更容易起疑
      "scan": {
        "schedule": { "firstPatrolSeconds": 45, "intervalSeconds": 75, "jitterSeconds": 20,
                      "minActions": 2, "maxActions": 4, "pauseMin": 1.5, "pauseMax": 4 },
        "suspicion": { "sweepAt": 30, "exposedAt": 100, "calmPerPatrol": 3, "sweepMultiplier": 2 }
      },
      // 到了掩盖这一步，他已经在留意这台机器了：来得最勤，一点小事就翻
      "cover": {
        "schedule": { "firstPatrolSeconds": 40, "intervalSeconds": 60, "jitterSeconds": 15,
                      "minActions": 2, "maxActions": 4, "pauseMin": 1, "pauseMax": 3 },
        "suspicion": { "sweepAt": 25, "exposedAt": 100, "calmPerPatrol": 2, "sweepMultiplier": 3 }
      }
    }
  },
  "steps": [
    { "id": "tunnel",  "title": "建隧道", "hint": "连上跳板机，建立通往内网的隧道。" },
    { "id": "scan",    "title": "扫描",   "hint": "通过隧道扫描跳板机所在的内网段，找到目标。" },
    { "id": "fetch",   "title": "拿取",   "hint": "从内网目标取得文件，复制回你的机器。" },
    { "id": "stealth", "title": "隐蔽",   "hint": "整个过程尽量别引起管理员的注意。" },
    { "id": "cover",   "title": "掩盖",   "hint": "清理白名单外进程留下的痕迹 —— 只删日志本身就是痕迹。" }
  ]
}
