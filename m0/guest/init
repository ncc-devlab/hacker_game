#!/bin/sh
# M0 initramfs init。
# 两种模式：
#   无 m0.root  -> 就地当极小客户机跑（目标机，纯内存，约 2 秒起）
#   有 m0.root  -> 挂载该块设备并 switch_root（主角机，完整 Alpine rootfs）
BB=/usr/bin/busybox
$BB mkdir -p /proc /sys /dev /tmp /run /bin /sbin /etc
$BB mount -t proc     proc     /proc
$BB mount -t sysfs    sysfs    /sys
$BB mount -t devtmpfs devtmpfs /dev 2>/dev/null
$BB --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root; mkdir -p /root

for m in virtio_pci virtio_net virtio_blk e1000 e1000e sd_mod ext4; do modprobe $m 2>/dev/null; done

. /lib/m0/common.sh

M0_ROOTDEV="$(m0_cmdline_get m0.root)"
if [ -n "$M0_ROOTDEV" ]; then
    mkdir -p /newroot
    n=0
    while [ ! -b "$M0_ROOTDEV" ] && [ $n -lt 50 ]; do sleep 0.1; n=$((n+1)); done
    if mount -t ext4 "$M0_ROOTDEV" /newroot; then
        mount --move /proc /newroot/proc 2>/dev/null
        mount --move /sys  /newroot/sys  2>/dev/null
        mount --move /dev  /newroot/dev  2>/dev/null
        exec switch_root /newroot /sbin/init
    fi
    echo "!! 挂载 $M0_ROOTDEV 失败，退回 initramfs shell"
fi

m0_mount_pty
m0_setup_net
m0_start_agent
m0_setup_sudo
m0_start_admin_tty
m0_open_access
m0_start_services
m0_place_content
m0_disguise
m0_banner
m0_console_loop
